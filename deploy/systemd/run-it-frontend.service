[Unit]
Description=Run It frontend (TanStack Start SSR)
Wants=network-online.target run-it-backend.service
After=network-online.target run-it-backend.service
StartLimitIntervalSec=60
StartLimitBurst=10

[Service]
Type=simple
User=@@APP_USER@@
Group=@@APP_GROUP@@
WorkingDirectory=@@APP_DIR@@/frontend
Environment=NODE_ENV=production
Environment=HOST=127.0.0.1
Environment=PORT=3002
ExecStart=/usr/bin/node @@APP_DIR@@/frontend/.output/server/index.mjs
Restart=on-failure
RestartSec=5
TimeoutStopSec=20
KillSignal=SIGTERM
UMask=0077

NoNewPrivileges=true
CapabilityBoundingSet=
AmbientCapabilities=
RestrictSUIDSGID=true
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ProtectHome=read-only
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectKernelLogs=true
ProtectControlGroups=true
ProtectClock=true
ProtectHostname=true
ProtectProc=invisible
ProcSubset=pid
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
IPAddressDeny=any
IPAddressAllow=localhost
RestrictNamespaces=true
RestrictRealtime=true
LockPersonality=true
SystemCallArchitectures=native
RemoveIPC=true

[Install]
WantedBy=multi-user.target
